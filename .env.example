# Copy to .env and fill in. Anything prefixed EXPO_PUBLIC_ is embedded in the
# app bundle and is readable by anyone who downloads the app — only ever put
# values here that are safe to be public. Supabase's publishable key is designed
# for exactly this; it is Row Level Security, not key secrecy, that protects data.
#
# The service_role / secret key must NEVER appear in this file or in the app.
# It belongs only in Supabase Edge Function secrets.

EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Account used only by `npm run test:ledger`, created automatically on first run.
# No EXPO_PUBLIC_ prefix, so it is never bundled into the app.
KOBOX_TEST_EMAIL=ledger-test@example.com
KOBOX_TEST_PASSWORD=choose-something-long
